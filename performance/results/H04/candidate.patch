+        /// Input-independent work: repeating an invocation cannot introduce scan scaling.
+        bool boundedWork(size_t index) {
+            ubyte[] states = new ubyte[names.length];
+            bool inspect(size_t current) {
+                auto node = expressions[current];
+                final switch (node.kind) {
+                case ExpressionKind.unknown:
+                case ExpressionKind.repetition:
+                    return false;
+                case ExpressionKind.terminal:
+                    // Known FIRST/nullability alone does not bound identifier/spacing scans.
+                    return node.byteTerminal || node.source == "eps"
+                        || node.source == "eoi" || node.source == "endOfInput"
+                        || node.source == "fail" || node.source == "eol" || node.source == "endOfLine";
+                case ExpressionKind.reference:
+                    const target = referenceRule(node);
+                    if (target == size_t.max)
+                        return false;
+                    if (states[target])
+                        return states[target] == 2;
+                    states[target] = 1;
+                    const bounded = inspect(roots[target]);
+                    states[target] = bounded ? 2 : 3;
+                    return bounded;
+                case ExpressionKind.wrapper:
+                    if (node.combinator != "discard"
+                            && node.combinator != "fuse"
+                            && node.combinator != "keep" && node.combinator != "drop"
+                            && node.combinator != "propagate" && node.combinator != "named"
+                            && node.combinator != "defined" && node.combinator != "branch")
+                        return false;
+                    goto case;
+                case ExpressionKind.sequence:
+                case ExpressionKind.choice:
+                case ExpressionKind.optional:
+                case ExpressionKind.predicate:
+                    foreach (child; node.children)
+                        if (!inspect(child))
+                            return false;
+                    return true;
+                }
+            }
+
+            return inspect(index);
+        }
